# Copia este archivo como .env (no se versiona) o define las variables en tu sistema / Render.
# "real" (predeterminado, APIs de Gestopago) o "simulado" (solo para programar sin conexión)
GESTOPAGO_MODO=real
# Datos del distribuidor que entrega Gestopago / el profesor
GESTOPAGO_ID_DISTRIBUIDOR=
GESTOPAGO_CODIGO_DISPOSITIVO=
# Con la contraseña la API obtiene y renueva sola el token de Gestopago (recomendado)
GESTOPAGO_PASSWORD=
# Opcionales: tokens fijos de respaldo (caducan)
GESTOPAGO_PRODUCTS_TOKEN=
GESTOPAGO_TX_TOKEN=
# Minimo 32 caracteres, aleatorio
APP_JWT_SECRET=
DATABASE_URL=
# URL del ambiente de PRUEBAS de Gestopago (no usar produccion para la entrega)
GESTOPAGO_URL=
# Ruta del servicio de consulta/validacion de referencias de Gestopago
GESTOPAGO_REFERENCIA_PATH=
# Origenes del frontend web, separados por coma (ej. https://hasani-web.onrender.com)
APP_CORS_ORIGINS=
